{
  "expo": {
    "name": "Francken",
    "slug": "francken-mobile",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash_2048.png",
          "resizeMode": "contain",
          "backgroundColor": "#131f2b"
        }
      ],
      "expo-asset"
    ],
    "icon": "./assets/icon/icon_1024.png",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#131f2b",
      "translucent": false
    }
  }
}
