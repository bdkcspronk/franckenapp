# Firebase web config of the association's project (Firebase console > Project settings > General >
# Your apps > Web app). Same project as the website. Copy to .env and fill in; .env is not committed.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tfvprofessorfrancken.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tfvprofessorfrancken
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# true = use the offline mock data in src/mocks instead of Firebase (also when the API key is empty)
EXPO_PUBLIC_USE_MOCK=false
